#魔女

execute if data storage main:pick {active:1b} unless entity @p[tag=PickBypass] as @p at @s run function main:job_selection/pick/input/job {job_id:21,pool:"wich",job_name:"魔女",job_function:"wich",sign_x:-1,sign_y:3}
